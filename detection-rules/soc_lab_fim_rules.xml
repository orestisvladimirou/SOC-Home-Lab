<group name="syscheck,soc_lab,">
  <rule id="100100" level="10">
    <if_sid>550</if_sid>
    <field name="file" type="pcre2">^/opt/soc-fim-test/critical-config\.conf$</field>
    <description>SOC Lab: Sensitive configuration file modified ($(file)).</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>
</group>
